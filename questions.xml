<?xml version='1.0' encoding='UTF-8'?>
<!DOCTYPE questestinterop SYSTEM "qti.dtd">
<questestinterop>
    <item ident="il_0_qst_1" title="Adding fractions" maxattempts="0">
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield>
                    <fieldlabel>externalId</fieldlabel>
                    <fieldentry>ITEM_Adding_fractions_1</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>QUESTIONTYPE</fieldlabel>
                    <fieldentry>assSingleChoice</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>AUTHOR</fieldlabel>
                    <fieldentry>Quarto QTI</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>additional_cont_edit_mode</fieldlabel>
                    <fieldentry>default</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>singleline</fieldlabel>
                    <fieldentry>1</fieldentry>
                </qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation label="Adding fractions">
            <flow>
                <material>
                    <mattext texttype="text/plain">Was ist 1/2 + 1/4?</mattext>
                </material>
                <response_lid ident="RESPONSE" rcardinality="Single">
                    <render_choice shuffle="No">
                        <response_label ident="CHOICE_1">
                            <material>
                                <mattext texttype="text/plain">1/4</mattext>
                            </material>
                        </response_label>
                        <response_label ident="CHOICE_2">
                            <material>
                                <mattext texttype="text/plain">3/4</mattext>
                            </material>
                        </response_label>
                        <response_label ident="CHOICE_3">
                            <material>
                                <mattext texttype="text/plain">1</mattext>
                            </material>
                        </response_label>
                    </render_choice>
                </response_lid>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="1"/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="RESPONSE">CHOICE_1</varequal>
                </conditionvar>
                <setvar varname="SCORE" action="Add">0</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="RESPONSE">CHOICE_2</varequal>
                </conditionvar>
                <setvar varname="SCORE" action="Add">1</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="RESPONSE">CHOICE_3</varequal>
                </conditionvar>
                <setvar varname="SCORE" action="Add">0</setvar>
            </respcondition>
        </resprocessing>
    </item>
    <item ident="il_0_qst_2" title="Fraction to decimal" maxattempts="0">
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield>
                    <fieldlabel>externalId</fieldlabel>
                    <fieldentry>ITEM_Fraction_to_decimal_2</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>QUESTIONTYPE</fieldlabel>
                    <fieldentry>assClozeTest</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>AUTHOR</fieldlabel>
                    <fieldentry>Quarto QTI</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>additional_cont_edit_mode</fieldlabel>
                    <fieldentry>default</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>textgaprating</fieldlabel>
                    <fieldentry>cs</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>identicalScoring</fieldlabel>
                    <fieldentry>1</fieldentry>
                </qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation label="Fraction to decimal">
            <flow>
                <material>
                    <mattext texttype="text/plain">Schreibe 1/2 als Dezimalzahl:</mattext>
                </material>
                <response_str ident="RESPONSE" rcardinality="Single">
                    <render_fib fibtype="String" prompt="Box" maxchars="20">
                        <response_label ident="GAP_1"/>
                    </render_fib>
                </response_str>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="1"/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="RESPONSE" case="Yes">0.5</varequal>
                </conditionvar>
                <setvar varname="SCORE" action="Add">1</setvar>
            </respcondition>
        </resprocessing>
    </item>
    <item ident="il_0_qst_3" title="ITEM_Welche_Aussage_ist_richtig_3" maxattempts="0">
        <itemmetadata>
            <qtimetadata>
                <qtimetadatafield>
                    <fieldlabel>externalId</fieldlabel>
                    <fieldentry>ITEM_Welche_Aussage_ist_richtig_3</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>QUESTIONTYPE</fieldlabel>
                    <fieldentry>assSingleChoice</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>AUTHOR</fieldlabel>
                    <fieldentry>Quarto QTI</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>additional_cont_edit_mode</fieldlabel>
                    <fieldentry>default</fieldentry>
                </qtimetadatafield>
                <qtimetadatafield>
                    <fieldlabel>singleline</fieldlabel>
                    <fieldentry>1</fieldentry>
                </qtimetadatafield>
            </qtimetadata>
        </itemmetadata>
        <presentation label="ITEM_Welche_Aussage_ist_richtig_3">
            <flow>
                <material>
                    <mattext texttype="text/plain">Welche Aussage ist richtig?</mattext>
                </material>
                <response_lid ident="RESPONSE" rcardinality="Single">
                    <render_choice shuffle="No">
                        <response_label ident="CHOICE_1">
                            <material>
                                <mattext texttype="text/plain">1/3 &lt; 1/2</mattext>
                            </material>
                        </response_label>
                        <response_label ident="CHOICE_2">
                            <material>
                                <mattext texttype="text/plain">1/3 &gt; 1/2</mattext>
                            </material>
                        </response_label>
                    </render_choice>
                </response_lid>
            </flow>
        </presentation>
        <resprocessing>
            <outcomes>
                <decvar varname="SCORE" vartype="Decimal" defaultval="0" minvalue="0" maxvalue="1"/>
            </outcomes>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="RESPONSE">CHOICE_1</varequal>
                </conditionvar>
                <setvar varname="SCORE" action="Add">1</setvar>
            </respcondition>
            <respcondition continue="Yes">
                <conditionvar>
                    <varequal respident="RESPONSE">CHOICE_2</varequal>
                </conditionvar>
                <setvar varname="SCORE" action="Add">0</setvar>
            </respcondition>
        </resprocessing>
    </item>
</questestinterop>
