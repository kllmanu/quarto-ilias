{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarto QTI question collection",
  "type": "object",
  "required": ["qti"],
  "properties": {
    "qti": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "identifier": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/title" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "title": {
      "type": "string"
    },
    "prompt": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "title": "One question, shaped by its interaction type",
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["choice", "text_entry"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "$ref": "#/$defs/choice" }
        },
        {
          "if": { "properties": { "type": { "const": "text_entry" } } },
          "then": { "$ref": "#/$defs/text_entry" }
        }
      ]
    },
    "choice": {
      "title": "Single-answer multiple choice",
      "type": "object",
      "required": ["type", "prompt", "choices"],
      "properties": {
        "type": { "const": "choice" },
        "identifier": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/title" },
        "prompt": { "$ref": "#/$defs/prompt" },
        "choices": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "identifier": { "$ref": "#/$defs/identifier" },
              "text": { "type": "string", "minLength": 1 },
              "correct": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          },
          "contains": {
            "type": "object",
            "required": ["correct"],
            "properties": { "correct": { "const": true } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      },
      "additionalProperties": false
    },
    "text_entry": {
      "title": "Text entry",
      "type": "object",
      "required": ["type", "prompt", "correct"],
      "properties": {
        "type": { "const": "text_entry" },
        "identifier": { "$ref": "#/$defs/identifier" },
        "title": { "$ref": "#/$defs/title" },
        "prompt": { "$ref": "#/$defs/prompt" },
        "correct": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
