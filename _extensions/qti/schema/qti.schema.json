{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarto QTI assessment front matter",
  "type": "object",
  "required": ["qti"],
  "properties": {
    "qti": {
      "type": "object",
      "required": ["questions"],
      "properties": {
        "identifier": { "$ref": "item.schema.json#/$defs/identifier" },
        "title": { "$ref": "item.schema.json#/$defs/title" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "question.schema.json" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
