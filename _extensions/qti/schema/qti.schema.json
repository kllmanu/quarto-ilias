{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quarto QTI question front matter",
  "type": "object",
  "required": ["qti"],
  "properties": {
    "qti": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "enum": ["choice", "text_entry"] }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "choice" } } },
          "then": { "$ref": "../interactions/choice/choice.schema.json" }
        },
        {
          "if": { "properties": { "type": { "const": "text_entry" } } },
          "then": { "$ref": "../interactions/text_entry/text_entry.schema.json" }
        }
      ]
    }
  },
  "additionalProperties": true
}
