{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Single-answer multiple choice",
  "type": "object",
  "required": ["type", "prompt", "choices"],
  "properties": {
    "type": { "const": "choice" },
    "identifier": { "$ref": "../../schema/item.schema.json#/$defs/identifier" },
    "title": { "$ref": "../../schema/item.schema.json#/$defs/title" },
    "prompt": { "$ref": "../../schema/item.schema.json#/$defs/prompt" },
    "choices": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "identifier": { "$ref": "../../schema/item.schema.json#/$defs/identifier" },
          "text": { "type": "string", "minLength": 1 },
          "correct": { "type": "boolean", "default": false }
        },
        "additionalProperties": false
      },
      "contains": {
        "type": "object",
        "required": ["correct"],
        "properties": { "correct": { "const": true } }
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "additionalProperties": false
}
