{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Text entry",
  "type": "object",
  "required": ["type", "prompt", "correct"],
  "properties": {
    "type": { "const": "text_entry" },
    "identifier": { "$ref": "../../schema/item.schema.json#/$defs/identifier" },
    "title": { "$ref": "../../schema/item.schema.json#/$defs/title" },
    "prompt": { "$ref": "../../schema/item.schema.json#/$defs/prompt" },
    "correct": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
